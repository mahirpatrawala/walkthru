{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run make:room && npx vite build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/look/tex/realistic/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/scenes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/scenes/([a-z0-9-]+)/baked/(.*\\.[0-9a-f]{8}\\.(?:webp|bin))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/characters/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/look/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/photo.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/editor.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/editor",
      "destination": "/",
      "permanent": false
    }
  ]
}
