{
  "name": "walkthru",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "make:room": "tsx scripts/make-test-room.ts",
    "fetch:assets": "tsx scripts/fetch-assets.ts",
    "fetch:sample": "tsx scripts/fetch-assets.ts --sample",
    "fetch:look": "tsx scripts/fetch-look-assets.ts",
    "setup": "npm run fetch:assets && npm run make:room",
    "import:drawing": "tsx scripts/import-drawing.ts",
    "media": "tsx scripts/media-worker.ts",
    "test:local": "WALKTHRU_LOCAL=1 vitest run --no-file-parallelism tests/*.local.test.ts"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "pdfjs-dist": "6.4.299",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
